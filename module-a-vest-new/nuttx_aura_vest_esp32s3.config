# NuttX config fragment for the Aura vest app on an ESP32-S3-style board.
# Merge these settings into the board .config, then adjust device paths in
# menuconfig to match the GPIO/PWM registration used by your BSP.

CONFIG_EXAMPLES_AURA_VEST=y
CONFIG_PWM=y
CONFIG_PWM_MULTICHAN=y
CONFIG_PWM_NCHANNELS=1
CONFIG_TIMER=y
CONFIG_DEV_GPIO=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_BLUETOOTH=y
CONFIG_NET_BLUETOOTH=y
CONFIG_ESPRESSIF_BLE=y
CONFIG_NIMBLE=y
CONFIG_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_NIMBLE_TINYCRYPT=y
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_SIG_EVTHREAD=y

CONFIG_ESP32_LEDC_TIM0=y
CONFIG_ESP32_LEDC_TIM0_CHANNELS=1
CONFIG_ESP32_LEDC_TIM1=y
CONFIG_ESP32_LEDC_TIM1_CHANNELS=1
CONFIG_ESP32_LEDC_TIM2=y
CONFIG_ESP32_LEDC_TIM2_CHANNELS=1
CONFIG_ESP32_LEDC_TIM3=y
CONFIG_ESP32_LEDC_TIM3_CHANNELS=1
CONFIG_ESP32_LEDC_CHANNEL0_PIN=25
CONFIG_ESP32_LEDC_CHANNEL1_PIN=26
CONFIG_ESP32_LEDC_CHANNEL2_PIN=27
CONFIG_ESP32_LEDC_CHANNEL3_PIN=33

CONFIG_EXAMPLES_AURA_VEST_TRIG_LEFT_DEV="/dev/gpio0"
CONFIG_EXAMPLES_AURA_VEST_ECHO_LEFT_DEV="/dev/gpio3"
CONFIG_EXAMPLES_AURA_VEST_TRIG_CENTER_DEV="/dev/gpio1"
CONFIG_EXAMPLES_AURA_VEST_ECHO_CENTER_DEV="/dev/gpio4"
CONFIG_EXAMPLES_AURA_VEST_TRIG_RIGHT_DEV="/dev/gpio2"
CONFIG_EXAMPLES_AURA_VEST_ECHO_RIGHT_DEV="/dev/gpio5"

CONFIG_EXAMPLES_AURA_VEST_MOTOR_LEFT_DEV="/dev/pwm0"
CONFIG_EXAMPLES_AURA_VEST_MOTOR_CENTER_LEFT_DEV="/dev/pwm1"
CONFIG_EXAMPLES_AURA_VEST_MOTOR_CENTER_RIGHT_DEV="/dev/pwm2"
CONFIG_EXAMPLES_AURA_VEST_MOTOR_RIGHT_DEV="/dev/pwm3"
CONFIG_EXAMPLES_AURA_VEST_MAX_MOTOR_DUTY=128

# Autostart through /etc/init.d/rcS. See module-a-vest-new/init.d/rcS.
CONFIG_FS_ROMFS=y
CONFIG_ETC_ROMFS=y
CONFIG_ETC_ROMFSMOUNTPT="/etc"
CONFIG_ETC_ROMFSDEVNO=0
CONFIG_ETC_ROMFSSECTSIZE=64
